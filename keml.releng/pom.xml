<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Spring Boot supplies compatible dependency and Maven plugin defaults. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>org.keml</groupId>
    <artifactId>keml.releng</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>KEML Sirius Web sample build</name>
    <description>Parent and complete Maven reactor for the KEML sample application.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <sirius.web.version>2026.7.3</sirius.web.version>
        <!-- Keep the existing EMF edit artifact version for embedding in Guesstimate. -->
        <keml.edit.version>1.0.0-SNAPSHOT</keml.edit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.keml</groupId>
                <artifactId>keml</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.keml</groupId>
                <artifactId>keml.edit</artifactId>
                <version>${keml.edit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.keml</groupId>
                <artifactId>keml.diagram</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.keml</groupId>
                <artifactId>keml.io</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.keml</groupId>
                <artifactId>keml.analysis</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.keml</groupId>
                <artifactId>keml.frontend</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <!-- Sirius Web's changelog uses Liquibase 4 APIs, as in Guesstimate. -->
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>4.33.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- These repository IDs must match the servers in your Maven settings.xml. -->
    <repositories>
        <repository>
            <id>github-sirius-web</id>
            <url>https://maven.pkg.github.com/eclipse-sirius/sirius-web</url>
        </repository>
        <repository>
            <id>github-sirius-emfjson</id>
            <url>https://maven.pkg.github.com/eclipse-sirius/sirius-emf-json</url>
        </repository>
    </repositories>

    <!-- Build from this POM so Maven resolves all KEML artifacts in one reactor. -->
    <modules>
        <module>../keml</module>
        <module>../keml.edit</module>
        <module>../keml.io</module>
        <module>../keml.analysis</module>
        <module>../keml.diagram</module>
        <module>../keml.frontend</module>
        <module>../keml.app</module>
    </modules>
</project>
